# AIC App — variáveis de deploy (Docker Compose)
# Copie para deploy/.env e ajuste antes de subir a stack.

# --- Rede / acesso ---
APP_HTTP_PORT=80
CORS_ORIGIN=http://localhost
FRONTEND_APP_URL=http://localhost

# --- MySQL ---
DB_ROOT_PASSWORD=change-me-root
DB_NAME=db_aic
DB_USER=aic_user
DB_PASSWORD=change-me-db

# --- Backend ---
JWT_SECRET=change-me-jwt-secret-use-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=8h
APP_TIMEZONE=America/Sao_Paulo
UPLOAD_MAX_BYTES=10485760

# Google Calendar (opcional — preencha em produção se usar integração)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/secretariat/google-calendar/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Git (instalação/atualização via scripts) ---
GIT_REPO_URL=https://github.com/francissantiago/AIC_APP.git
GIT_BRANCH=main
INSTALL_DIR=
